# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
    PATH="$PATH:$HOME/.dotnet/tools"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc


# Rust/Cargo
export PATH="$HOME/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin:$HOME/.cargo/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Work journal (single source of truth: JORNAL → repo via symlink)
export JORNAL="$HOME/para/areas/jornal"
export JOURNAL_PATH="$JORNAL"                           # incitaciones /close target (same repo)
export JOURNAL_LOG_SUBDIR="areas/log"                    # repo daily-log layout

# TypeSafe API key (used by the TypeSafe System One SDK)
export TYPESAFE_API_KEY="{{ .typesafe.api_key }}"

# OpenRouter API key (chatdispatch tier 1 / LLM-driven fallback)
export OPENROUTER_API_KEY="{{ .openrouter.api_key }}"

# Mistral + HuggingFace keys (fill in chezmoi.toml [data.mistral] / [data.huggingface], then: chezmoi apply ~/.bashrc)
# export MISTRAL_API_KEY="{{ .mistral.api_key }}"
# export HF_TOKEN="{{ .huggingface.api_key }}"
